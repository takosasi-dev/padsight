<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PadSight</AssemblyName>
    <RootNamespace>PadSight.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>padsight.ico</ApplicationIcon>
    <!-- 画面は日本語だけなので、.NET と WPF の他の言語の表示用ファイルを配布物に入れない(exe が 138.3 MB から 129.7 MB に。2026-11-18) -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PadSight.Core\PadSight.Core.csproj" />
    <ProjectReference Include="..\PadSight.Input\PadSight.Input.csproj" />
    <ProjectReference Include="..\OverlayCore\OverlayCore.csproj" />
    <PackageReference Include="H.NotifyIcon.Wpf" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="padsight.ico" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" LogicalName="THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
