<!-- OverlayProbe の操作用の小さな窓(普通の窓。最前面にしない)。 -->
<!-- 重ねる窓のクリックを通すかを切り替え、「終了」でアプリごと閉じる。 -->
<Window x:Class="OverlayProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OverlayProbe の操作" Width="280" Height="150" ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <CheckBox x:Name="ClickThrough" Content="クリックを通す" IsChecked="True" Click="OnClickThrough" />
        <Button Content="終了" Width="96" Margin="0,24,0,0" HorizontalAlignment="Left" Click="OnExit" />
    </StackPanel>
</Window>
