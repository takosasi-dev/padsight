<!-- PerfProbe: InputEngine に作った入力を流して、スナップショットの割り当てと時間を測るコンソール。 -->
<!-- Core だけを参照する(SDL・WPF・窓は使わない)。 -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PadSight.Core\PadSight.Core.csproj" />
  </ItemGroup>

</Project>
